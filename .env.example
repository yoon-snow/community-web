# Existing MongoDB diagnostic only (optional; not used by the club app)
MONGODB_URI=
# Separate Supabase projects for local/staging and production.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Exact trusted production origin, no trailing slash. Used for email confirmation/recovery links.
APP_URL=http://localhost:3000
# Server-only configuration. Must be explicitly set before production submissions are accepted.
PRIVACY_POLICY_TEXT=
PRIVACY_RETENTION_DAYS=
PRIVACY_CONTACT=
CLUB_BANK_NAME=카카오뱅크
CLUB_BANK_ACCOUNT=3333349466142
CLUB_BANK_HOLDER=황태호
# Generate locally: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:replace-with-operator@example.com
# Random >=32 bytes; Vercel sends Authorization: Bearer CRON_SECRET.
CRON_SECRET=
# Development preview has fictional records only. Preview route also displays a permanent banner.
NEXT_PUBLIC_ENABLE_PREVIEW=false
